# Build de DEMONSTRAÇÃO ABERTA (npm run build:demo).
# Versão estática para mostrar o fluxo: entra direto como usuário fictício,
# sem tela de login e sem backend; todas as respostas vêm dos mocks.
# Não contém segredos. NÃO usar este modo para publicar o sistema real.
VITE_DEMO_ABERTA=true
# Exigido pelo cliente da API ao carregar; nunca é chamado no modo demo.
VITE_API_URL=http://localhost:8000
