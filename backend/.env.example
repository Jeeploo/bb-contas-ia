# Desenvolvimento. Para homologação externa: APP_ENV=homologation (ou staging).
APP_ENV=development
# Habilita somente usuários/credenciais de demonstração; nunca autenticação institucional.
DEMO_MODE=false

# Aceita postgresql://, postgres:// ou postgresql+psycopg://; nunca inserir segredo real aqui.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
# Em homologação, origem HTTPS exata obrigatória; sem barra final, caminho, lista ou wildcard.
# Desenvolvimento permite também http://127.0.0.1:5173 e http://localhost:5173.
FRONTEND_ORIGIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
# Segundos: validade absoluta da sessão.
SESSION_TTL=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BLOCK_SECONDS=300
PORT=8000
# IPs/redes do proxy confiável, separados por vírgula. Nunca aceitar X-Forwarded-For arbitrário.
FORWARDED_ALLOW_IPS=127.0.0.1

# local no desenvolvimento; r2 permite backend com filesystem efêmero.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./storage/documentos
# Exigido apenas para local em ambiente externo (não para r2).
DOCUMENT_STORAGE_PERSISTENT=false
# R2 privado, via API S3. Valores reais somente nos secrets do backend.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
DOCUMENT_MAX_SIZE_BYTES=10485760
MAX_OCR_PAGES=10
UF_MVP=PE

DOCUMENT_AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=
OPENAI_DOCUMENT_TIMEOUT=90
OPENAI_DOCUMENT_MAX_OUTPUT_TOKENS=6000
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash-lite
GEMINI_DOCUMENT_TIMEOUT=90
GEMINI_DOCUMENT_MAX_OUTPUT_TOKENS=6000
